<local:View x:Class="WinMemoryCleaner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WinMemoryCleaner"
    Background="{DynamicResource PrimaryBackground}" Foreground="{DynamicResource SecondaryForeground}" DataContext="{Binding MainViewModel, Source={StaticResource ViewModelLocator}}"
    FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="{Binding FontSize}" Title="{Binding Title}" Icon="/WinMemoryCleaner.Community;component/Resources/Images/win-memory-cleaner.ico"
    Topmost="{Binding AlwaysOnTop}" FlowDirection="{Binding Path=(local:Localizer.Language).Direction}" FocusManager.FocusedElement="{Binding ElementName=Optimize}" MouseDown="OnWindowMouseDown" Height="700" Width="960" MinHeight="520" MinWidth="760" ResizeMode="CanResizeWithGrip" WindowStyle="None" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="20,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/WinMemoryCleaner.Community;component/Resources/Images/win-memory-cleaner.ico" Width="24" Height="24" ToolTip="{x:Static local:Constants+App.Attribution}"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="?" Padding="10,6" Click="OnHelpButtonClick" ToolTip="{Binding Monitoring.Labels[Help], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}">
                    <Button.Resources><ContextMenu x:Key="HelpContextMenu">
                        <MenuItem Command="{Binding NavigateUriCommand}" CommandParameter="{x:Static local:Constants+App+Repository.AboutUri}" Header="{Binding Path=(local:Localizer.String).About}"/>
                        <MenuItem Click="OnResetSettingsToDefaultConfigurationClick" Header="{Binding Path=(local:Localizer.String).Reset}"/>
                        <MenuItem Click="OnDonateMenuItemClick" Header="{Binding Path=(local:Localizer.String).Donate}"/>
                    </ContextMenu></Button.Resources>
                </Button>
                <CheckBox IsChecked="{Binding CompactMode}" Content="{Binding Monitoring.Labels[Compact], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Margin="12,0"/>
                <Button Content="—" Padding="10,6" Click="OnMinimizeButtonClick" ToolTip="{Binding Path=(local:Localizer.String).Minimize}" Margin="0,0,4,0"/>
                <Button Content="×" Padding="10,6" Click="OnCloseButtonClick" ToolTip="{Binding Path=(local:Localizer.String).Close}"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="MonitorHost" Grid.Row="1" DataContext="{Binding Monitoring, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Margin="20,0,20,0"
              Visibility="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Labels[Refresh]}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding RefreshChoices}" SelectedItem="{Binding RefreshSeconds}" MinWidth="46"/>
                </StackPanel>
                <RadioButton x:Name="OverviewNav" Content="{Binding Labels[Overview]}" IsChecked="True" Tag="0" GroupName="Pages" Style="{StaticResource MonitorNav}" Checked="OnPageChecked"/>
                <RadioButton x:Name="ProcessNav" Content="{Binding Labels[Processes]}" Tag="1" GroupName="Pages" Style="{StaticResource MonitorNav}" Checked="OnPageChecked"/>
                <RadioButton x:Name="SettingsNav" Content="{Binding Labels[Settings]}" Tag="2" GroupName="Pages" Style="{StaticResource MonitorNav}" Checked="OnPageChecked"/>
            </DockPanel>
            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource MonitorPanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid><TextBlock Text="{Binding Labels[Memory]}" Style="{StaticResource MonitorLabel}"/><TextBlock Text="{Binding MemoryText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                            <ProgressBar x:Name="MemoryUsageBar" Value="{Binding DataContext.Computer.Memory.Physical.Used.Percentage, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Maximum="100" Height="10" Margin="0,12,0,14" Style="{StaticResource MonitorProgress}"/>
                            <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}">
                                <TextBlock Text="{Binding Path=(local:Localizer.String).Used}"/><TextBlock Text="{Binding Computer.Memory.Physical.Used.Value, StringFormat={}{0:0.0}}" Margin="10,0,4,0"/><TextBlock Text="{Binding Computer.Memory.Physical.Used.Unit}"/>
                                <TextBlock Text=" / " Margin="10,0"/><TextBlock Text="{Binding Computer.Memory.Physical.Total.Value, StringFormat={}{0:0.0}}" Margin="0,0,4,0"/><TextBlock Text="{Binding Computer.Memory.Physical.Total.Unit}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MonitorPanel}"><StackPanel>
                            <TextBlock Text="{Binding Labels[Cpu]}" Style="{StaticResource MonitorLabel}"/><TextBlock x:Name="CpuValue" Text="{Binding CpuText}" Style="{StaticResource MonitorReading}"/>
                            <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource MonitorNote}"/>
                            <Border Height="1" Background="{DynamicResource PrimaryBorder}" Margin="0,10"/>
                            <TextBlock Text="{Binding Labels[CpuTemperature]}" Style="{StaticResource MonitorLabel}"/><TextBlock x:Name="CpuTemperatureValue" Text="{Binding CpuTemperatureText}" FontSize="20"/>
                            <TextBlock Text="{Binding CpuTemperatureDetail}" Style="{StaticResource MonitorNote}"/>
                        </StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource MonitorPanel}"><StackPanel>
                            <TextBlock Text="{Binding Labels[Gpu]}" Style="{StaticResource MonitorLabel}"/><TextBlock x:Name="GpuValue" Text="{Binding GpuText}" Style="{StaticResource MonitorReading}"/>
                            <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap"/><TextBlock Text="{Binding GpuDetail}" Style="{StaticResource MonitorNote}"/>
                            <Border Height="1" Background="{DynamicResource PrimaryBorder}" Margin="0,10"/>
                            <TextBlock Text="{Binding Labels[GpuTemperature]}" Style="{StaticResource MonitorLabel}"/><TextBlock x:Name="GpuTemperatureValue" Text="{Binding GpuTemperatureText}" FontSize="20"/>
                            <TextBlock Text="{Binding GpuTemperatureDetail}" Style="{StaticResource MonitorNote}"/>
                        </StackPanel></Border>
                    </Grid>
                    <TextBlock Text="{Binding Labels[Normalized]}" Style="{StaticResource MonitorNote}"/>
                    <TextBlock Text="{Binding Labels[TemperatureNote]}" Style="{StaticResource MonitorNote}"/>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ProcessPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- One row for search, count, clear and refresh keeps the table tall enough at the 520px minimum. -->
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{Binding Labels[RefreshNow]}" Style="{StaticResource MonitorButton}" Click="OnRefreshClick" Margin="8,0,0,0"/>
                        <Button x:Name="ClearProcessSearch" DockPanel.Dock="Right" Content="{Binding Labels[ClearSearch]}" AutomationProperties.Name="{Binding Labels[ClearSearchName]}" IsEnabled="{Binding CanClearSearch}" Style="{StaticResource MonitorButton}" Padding="10,4" Margin="8,0,0,0" Click="OnClearProcessSearch"/>
                        <TextBox x:Name="ProcessSearch" DockPanel.Dock="Right" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Labels[Search]}" Style="{StaticResource MonitorSearchBox}" Height="34" MinWidth="200" KeyDown="OnProcessSearchKeyDown"/>
                        <TextBlock x:Name="ProcessCountDisplay" Text="{Binding ProcessCountText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </DockPanel>
                    <TextBlock x:Name="ProcessStatus" Grid.Row="1" Text="{Binding ProcessStatusText}" ToolTip="{Binding ProcessStatusDetail}" Visibility="{Binding HasProcessStatus, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ProcessStatusText}"/>
                </Grid>
                <Grid Grid.Row="1">
                <DataGrid x:Name="ProcessGrid" ItemsSource="{Binding ProcessesView}" SelectedItem="{Binding SelectedProcess}" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="{DynamicResource PrimaryBorder}" BorderBrush="{DynamicResource PrimaryBorder}" Background="{DynamicResource PrimaryBackground}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Sorting="OnProcessSorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="Name" SortMemberPath="Name" Width="*" MinWidth="100" ElementStyle="{StaticResource ProcessCell}"/>
                        <DataGridTextColumn Binding="{Binding Id}" Header="PID" SortMemberPath="Id" Width="64" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource NumericColumnHeader}"/>
                        <DataGridTextColumn Binding="{Binding MemoryText}" Header="Working set" SortMemberPath="WorkingSetBytes" Width="108" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource NumericColumnHeader}"/>
                        <DataGridTextColumn Binding="{Binding PrivateText}" Header="Private" SortMemberPath="PrivateBytes" Width="108" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource NumericColumnHeader}"/>
                        <DataGridTextColumn Binding="{Binding CpuText}" Header="CPU %" SortMemberPath="CpuUsage" Width="74" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource NumericColumnHeader}"/>
                        <DataGridTextColumn Binding="{Binding GpuText}" Header="GPU %" SortMemberPath="GpuUsage" Width="74" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource NumericColumnHeader}"/>
                        <DataGridTextColumn Binding="{Binding GpuMemoryText}" Header="VRAM" SortMemberPath="GpuMemoryBytes" Width="108" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource NumericColumnHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="ProcessEmptyState" Text="{Binding ProcessStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24" Foreground="{DynamicResource SecondaryDisabled}" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ElementName=ProcessGrid, Path=Items.Count}" Value="0"/><Condition Binding="{Binding HasProcessStatus}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding Labels[ProcessNote]}" Style="{StaticResource MonitorNote}"/>
                    <WrapPanel><Button x:Name="TrimSelected" Content="{Binding Labels[Trim]}" Click="OnTrimClick" Style="{StaticResource ProcessActionButton}" Margin="0,0,10,0"/><Button x:Name="TerminateSelected" Content="{Binding Labels[Terminate]}" Click="OnTerminateClick" BorderBrush="#D85A65" Foreground="#D34B58" Style="{StaticResource ProcessActionButton}"/></WrapPanel>
                    <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Labels[TrimNote]}" Style="{StaticResource MonitorNote}"/>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource MonitorPanel}" Margin="0,0,0,16"><StackPanel>
                        <TextBlock Text="{Binding Labels[Overlay]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <CheckBox x:Name="OverlayToggle" Content="{Binding Labels[OverlayEnabled]}" IsChecked="{Binding OverlayEnabled}" Margin="0,0,0,12"/>
                        <CheckBox Content="{Binding Labels[ClickThrough]}" IsChecked="{Binding ClickThrough}" Margin="0,0,0,14"/>
                        <WrapPanel><StackPanel Margin="0,0,18,12"><TextBlock Text="{Binding Labels[Display]}" Style="{StaticResource MonitorLabel}"/><ComboBox ItemsSource="{Binding Displays}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OverlayScreen}" MinWidth="220" DropDownOpened="OnDisplayDropDown"/></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="{Binding Labels[Position]}" Style="{StaticResource MonitorLabel}"/><ComboBox x:Name="OverlayCornerChoice" SelectedIndex="{Binding OverlayCorner}" MinWidth="120"><ComboBoxItem Content="{Binding Labels[TopLeft]}"/><ComboBoxItem Content="{Binding Labels[TopRight]}"/><ComboBoxItem Content="{Binding Labels[BottomLeft]}"/><ComboBoxItem Content="{Binding Labels[BottomRight]}"/><ComboBoxItem Content="{Binding Labels[Custom]}"/></ComboBox></StackPanel>
                            <StackPanel Margin="0,0,18,12"><TextBlock Text="{Binding Labels[Layout]}" Style="{StaticResource MonitorLabel}"/><ComboBox x:Name="OverlayLayoutChoice" SelectedIndex="{Binding OverlayLayout}" MinWidth="140"><ComboBoxItem Content="{Binding Labels[Horizontal]}"/><ComboBoxItem Content="{Binding Labels[Vertical]}"/></ComboBox></StackPanel>
                            <Button Content="{Binding Labels[Drag]}" Style="{StaticResource MonitorButton}" Click="OnDragOverlay" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Labels[Items]}" Style="{StaticResource MonitorLabel}"/>
                        <WrapPanel><CheckBox Content="{Binding Labels[Cpu]}" IsChecked="{Binding ShowCpu}" Margin="0,0,18,10"/><CheckBox Content="{Binding Labels[Gpu]}" IsChecked="{Binding ShowGpu}" Margin="0,0,18,10"/><CheckBox Content="{Binding Labels[Memory]}" IsChecked="{Binding ShowMemory}" Margin="0,0,18,10"/><CheckBox Content="{Binding Labels[CpuTemperature]}" IsChecked="{Binding ShowCpuTemperature}" Margin="0,0,18,10"/><CheckBox Content="{Binding Labels[GpuTemperature]}" IsChecked="{Binding ShowGpuTemperature}" Margin="0,0,18,10"/></WrapPanel>
                        <DockPanel Margin="0,2,0,8" LastChildFill="True">
                            <Button x:Name="InstallTemperatureDriver" DockPanel.Dock="Right" Content="{Binding Labels[InstallSensorDriver]}" Click="OnInstallTemperatureDriver" IsEnabled="{Binding CanInstallDriver}" Style="{StaticResource MonitorButton}" Margin="12,0,0,0"/>
                            <TextBlock x:Name="TemperatureStatus" Text="{Binding TemperatureStatusText}" ToolTip="{Binding TemperatureStatusDetail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Labels[OverlayNote]}" Style="{StaticResource MonitorNote}"/>
                        <Button x:Name="ShowMonitorOnly" Content="{Binding Labels[OnlyMonitor]}" Click="OnMonitorOnlyClick" Style="{StaticResource MonitorButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Labels[MonitorOnlyNote]}" Style="{StaticResource MonitorNote}"/>
                    </StackPanel></Border>
                    <ContentControl x:Name="SettingsHost"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <!-- Hidden (not Collapsed) keeps the footer height stable while progress replaces the summary. -->
                <StackPanel x:Name="MemorySummary" VerticalAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsOptimizationRunning}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding PhysicalMemoryHeader}"/><TextBlock Text="{Binding VirtualMemoryHeader}" Visibility="{Binding ShowVirtualMemory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Monitoring.Labels[ResourceNote], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Foreground="{DynamicResource SecondaryDisabled}" TextWrapping="Wrap" Margin="0,6,14,0" Visibility="{Binding CompactMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel x:Name="OptimizationProgressPanel" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding IsOptimizationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="OptimizationElapsed" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryDisabled}" Margin="12,0,0,0"/>
                        <TextBlock x:Name="OptimizationCount" DockPanel.Dock="Right" Margin="12,0,0,0">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="OptimizationProgressValue"/><Binding Path="OptimizationProgressTotal"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                        <TextBlock x:Name="OptimizationStep" Text="{Binding OptimizationProgressStep}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar x:Name="OptimizationProgressBar" Maximum="{Binding OptimizationProgressTotal, Mode=OneWay}" Value="{Binding OptimizationProgressValue, Mode=OneWay}" Height="6" Margin="0,8,0,0" Style="{StaticResource MonitorProgress}"/>
                </StackPanel>
                <Button x:Name="Optimize" Grid.Column="1" Content="{Binding Path=(local:Localizer.String).Optimize}" Command="{Binding OptimizeCommand}" Padding="26,12" BorderBrush="{DynamicResource Accent}" Style="{StaticResource MonitorButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ResizeGrip x:Name="WindowResizeGrip" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"/>
    </Grid>
    </Border>
</local:View>
