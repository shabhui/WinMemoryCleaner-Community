<UserControl x:Class="WinMemoryCleaner.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WinMemoryCleaner">
    <UserControl.Resources>
        <DataTemplate x:Key="SettingCheck"><CheckBox Content="{Binding Name}" IsChecked="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" Margin="0,0,0,9"/></DataTemplate>
        <DataTemplate x:Key="ColorChoice"><StackPanel Orientation="Horizontal"><Rectangle Fill="{Binding}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{Binding Converter={StaticResource BrushToHexConverter}}"/></StackPanel></DataTemplate>
        <Style x:Key="SettingsGroup" TargetType="GroupBox"><Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    </UserControl.Resources>
    <StackPanel>
        <GroupBox Header="{Binding Monitoring.Labels[Appearance], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,16">
                    <ComboBox x:Name="LanguagePicker" ItemsSource="{x:Static local:Localizer.Languages}" SelectedValue="{Binding Language}" MinWidth="175" Margin="0,0,20,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8"><TextBlock Text="{Binding Monitoring.Labels[FontSize], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" VerticalAlignment="Center" Margin="0,0,10,0"/><Slider x:Name="FontSizeSlider" Minimum="12" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding FontSize}" Width="110" VerticalAlignment="Center"/></StackPanel>
                    <RadioButton x:Name="DarkTheme" GroupName="Theme" Content="{Binding Monitoring.Labels[Dark], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Tag="Dark" Click="OnThemeClick" Margin="0,0,16,8" VerticalAlignment="Center"/>
                    <RadioButton x:Name="LightTheme" GroupName="Theme" Content="{Binding Monitoring.Labels[Light], RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Tag="Light" Click="OnThemeClick" Margin="0,0,0,8" VerticalAlignment="Center"/>
                </WrapPanel>
                <ItemsControl x:Name="SettingItemsControl" ItemsSource="{Binding SettingItems}" ItemTemplate="{StaticResource SettingCheck}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{Binding Path=(local:Localizer.String).MemoryAreas}" Style="{StaticResource SettingsGroup}"><ItemsControl x:Name="MemoryAreaItemsControl" ItemsSource="{Binding MemoryAreaItems}" ItemTemplate="{StaticResource SettingCheck}"/></GroupBox>
        <GroupBox Header="{Binding Path=(local:Localizer.String).OptimizationHotkey}" Style="{StaticResource SettingsGroup}" Visibility="{Binding Computer.OperatingSystem.HasHotkeyManager, Converter={StaticResource BooleanToVisibilityConverter}}">
            <WrapPanel>
                <CheckBox IsChecked="{Binding UseHotkey}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="OptimizationModifiers" ItemsSource="{Binding KeyboardModifiers}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding OptimizationModifiers}" IsEnabled="{Binding UseHotkey}" MinWidth="110"/>
                <TextBlock Text="+" Margin="10,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="OptimizationKey" ItemsSource="{Binding KeyboardKeys}" SelectedValue="{Binding OptimizationKey}" IsEnabled="{Binding UseHotkey}" MinWidth="80"/>
                <TextBlock Text="{Binding Path=(local:Localizer.String).Invalid}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsOptimizationKeyValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </WrapPanel>
        </GroupBox>
        <GroupBox Header="{Binding Path=(local:Localizer.String).AutoOptimization}" Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <TextBlock Text="{Binding AutoOptimizationMemoryIntervalDescription}" TextWrapping="Wrap"/>
                <Slider x:Name="AutoOptimizationIntervalSlider" Value="{Binding AutoOptimizationInterval}" Minimum="0" Maximum="168" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,12,0,20"/>
                <TextBlock Text="{Binding AutoOptimizationMemoryUsageDescription}" TextWrapping="Wrap"/>
                <Slider x:Name="AutoOptimizationMemoryUsageSlider" Value="{Binding AutoOptimizationMemoryUsage}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{Binding AutoOptimizationMemoryUsageWarning}" Margin="0,12,0,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{Binding Path=(local:Localizer.String).ProcessExclusionList}" Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <TextBlock Text="{Binding Path=(local:Localizer.String).ProcessExclusionListDescription}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ScrollViewer x:Name="ProcessExclusionScrollViewer" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProcessExclusionList" ItemsSource="{Binding ProcessExclusionList}"><ItemsControl.ItemTemplate><DataTemplate>
                        <DockPanel Margin="0,0,0,6"><Button Content="−" DockPanel.Dock="Left" Padding="10,2" Command="{Binding DataContext.RemoveProcessFromExclusionListCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsPanel}}}" CommandParameter="{Binding}" ToolTip="{Binding Path=(local:Localizer.String).Remove}"/><TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center"/></DockPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="Processes" IsEditable="True" ItemsSource="{Binding Processes}" SelectedValue="{Binding SelectedProcess}" DropDownOpened="OnProcessesDropDownOpened"/>
                    <Button x:Name="AddExclusion" Grid.Column="1" Content="+" Command="{Binding AddProcessToExclusionListCommand}" CommandParameter="{Binding Text, ElementName=Processes}" ToolTip="{Binding Path=(local:Localizer.String).Add}" Padding="14,4" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{Binding Path=(local:Localizer.String).TrayIcon}" Style="{StaticResource SettingsGroup}">
            <StackPanel>
                <ItemsControl x:Name="TrayIconItemsControl" ItemsSource="{Binding TrayIconItems}" ItemTemplate="{StaticResource SettingCheck}"/>
                <Grid IsEnabled="{Binding TrayIconShowMemoryUsage}" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Path=(local:Localizer.String).Background}" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox x:Name="TrayIconBackgroundColor" Grid.Column="2" ItemsSource="{Binding Brushes}" ItemTemplate="{StaticResource ColorChoice}" SelectedItem="{Binding TrayIconBackgroundColor}" IsEnabled="{Binding TrayIconUseTransparentBackground, Converter={StaticResource InverseBooleanConverter}}" MinWidth="140" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="{Binding Path=(local:Localizer.String).Text}" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox x:Name="TrayIconTextColor" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Brushes}" ItemTemplate="{StaticResource ColorChoice}" SelectedItem="{Binding TrayIconTextColor}" MinWidth="140" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="2" Text="{Binding Path=(local:Localizer.String).Optimizing}" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox x:Name="TrayIconOptimizingColor" Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Brushes}" ItemTemplate="{StaticResource ColorChoice}" SelectedItem="{Binding TrayIconOptimizingColor}" MinWidth="140" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="3" Text="{Binding Path=(local:Localizer.String).WarningLevel}" VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox x:Name="TrayIconWarningLevel" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MemoryUsageThresholds}" SelectedItem="{Binding TrayIconWarningLevel}" MinWidth="62" Margin="0,0,10,10"/>
                    <ComboBox x:Name="TrayIconWarningColor" Grid.Row="3" Grid.Column="2" ItemsSource="{Binding Brushes}" ItemTemplate="{StaticResource ColorChoice}" SelectedItem="{Binding TrayIconWarningColor}" MinWidth="140" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="4" Text="{Binding Path=(local:Localizer.String).DangerLevel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TrayIconDangerLevel" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding MemoryUsageThresholds}" SelectedItem="{Binding TrayIconDangerLevel}" MinWidth="62" Margin="0,0,10,0"/>
                    <ComboBox x:Name="TrayIconDangerColor" Grid.Row="4" Grid.Column="2" ItemsSource="{Binding Brushes}" ItemTemplate="{StaticResource ColorChoice}" SelectedItem="{Binding TrayIconDangerColor}" MinWidth="140"/>
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
